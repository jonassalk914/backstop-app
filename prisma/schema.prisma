// Backstop schema — minimal, indexed for the queries we actually run.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Coach {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  slug              String   @unique
  phone             String?
  enabled           Boolean  @default(true)
  paymentInstructions String? // free text: "Venmo @mike-r" or "Cash App $mikecoach"
  paymentMethods    String[] @default([]) // ["Venmo", "Zelle", "Cash"]
  // Public booking page customization. All nullable — only renders when set,
  // and falls back to safe defaults so /book/[slug] still works for coaches
  // who haven't customized anything. None of these are used outside the
  // public booking page; auth/admin/dashboard stay on the canonical fields.
  displayName       String?  // overrides "{firstName} {lastName}" headline
  bio               String?  // short paragraph shown below the headline
  publicEmail       String?  // contact email shown publicly (login email stays private)
  accentColor       String?  // hex like "#d4ff00" — only the public page reads this
  logoUrl           String?  // optional image URL for the public header
  venmoHandle       String?
  cashAppHandle     String?
  zelleInfo         String?
  cashInstructions  String?
  // IANA timezone (e.g. "America/New_York"). The coach's weekly windows
  // are minutes-from-midnight in this zone, and every player/coach surface
  // displays times in this zone — so both sides see the same wall clock
  // regardless of their browser/server location.
  timezone          String   @default("America/New_York")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  services      Service[]
  availability  Availability[]
  overrides     AvailabilityOverride[]
  bookings      Booking[]
  players       Player[]
}

model Service {
  id              String   @id @default(cuid())
  coachId         String
  name            String
  durationMinutes Int
  priceCents      Int      // store cents to avoid float drift
  // Max players per time slot. 1 = traditional 1-on-1; >1 = group lesson
  // (e.g. 2-on-1 = 2). Bookings on the same coach+service+startTime stack
  // up to this number; once full the slot disappears from the player flow.
  capacity        Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  coach    Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([coachId, active])
}

// Weekly recurring availability — the source of truth.
// dayOfWeek: 0=Sunday..6=Saturday. Times are minutes-from-midnight
// in the server's local TZ (set Vercel TZ env var for consistency).
model Availability {
  id          String @id @default(cuid())
  coachId     String
  dayOfWeek   Int    // 0-6
  startMinute Int    // 0-1439
  endMinute   Int    // 1-1440, must be > startMinute

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, dayOfWeek])
}

// Date-specific overrides that layer on top of weekly availability.
// Effective availability for a date = (weekly windows for that DOW)
//   minus BLOCK override ranges
//   plus  ADD override ranges
//
// startMinute/endMinute are optional ONLY when the override is meant to
// cover the whole day (e.g. "block all of April 28"). For partial-day
// overrides, both must be set and end > start.
model AvailabilityOverride {
  id          String              @id @default(cuid())
  coachId     String
  date        DateTime            @db.Date
  type        AvailabilityOverrideType
  startMinute Int?                // null = whole-day override
  endMinute   Int?                // null = whole-day override
  createdAt   DateTime            @default(now())

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, date])
}

enum AvailabilityOverrideType {
  ADD
  BLOCK
}

// Players are scoped to a coach. Same person booking with two different
// coaches = two Player records (intentional — each coach has their own roster).
model Player {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  coach    Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  bookings Booking[]

  // Unique-per-coach on contact info. NULL values don't conflict in Postgres,
  // so a coach can have multiple players with no email — fine.
  @@unique([coachId, phone])
  @@unique([coachId, email])
  @@index([coachId])
}

model Booking {
  id            String        @id @default(cuid())
  coachId       String
  playerId      String
  serviceId     String

  startTime     DateTime      // UTC
  endTime       DateTime      // UTC

  // Financial fields — manually managed by coach
  priceCents    Int           // snapshot at booking time
  amountPaidCents Int         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?       // "Venmo", "Cash", etc.
  paymentNotes  String?
  paidAt        DateTime?

  status        BookingStatus @default(CONFIRMED)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  coach   Coach   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // Conflict prevention is now done transactionally inside
  // createBookingAtomic — group lessons let multiple CONFIRMED bookings
  // share the same coach + service + startTime up to service.capacity, so a
  // hard unique on (coachId, startTime) is no longer compatible.
  @@index([coachId, startTime])
  @@index([coachId, serviceId, startTime])
  @@index([playerId])
  @@index([coachId, paymentStatus])
}
